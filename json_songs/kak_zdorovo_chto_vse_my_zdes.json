{
  "name": "Как здорово что все мы здесь",
  "category": "Патриотические и Военные Песни",
  "performing_artist": "О. Митяев",
  "author_music": "О. Митяев",
  "author_lyrics": "О. Митяев",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Изгиб гитары желтой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ты обнимаешь нежно,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Струна осколком эха"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "пронзит тугую высь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Качнется купол неба"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "большой и звездно-снежный,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Как здорово,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "что все мы здесь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "сегодня собрались."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как отблеск от заката,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "костёр меж сосен пляшет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты что грустишь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "бродяга, а ну-ка, улыбнись."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И кто-то очень близкий"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "тебе тихонько скажет -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Как здорово,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "что все мы здесь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "сегодня собрались."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И всё же, с болью в горле"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "мы тех сегодня вспомним,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чьи имена, как раны,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "на сердце запеклись,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Мечтами их и песнями"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "мы каждый вдох наполним,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Как здорово,"
