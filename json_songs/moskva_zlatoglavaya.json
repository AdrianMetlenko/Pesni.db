    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все прошло, все умчалося"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В невозвратную даль."
    },
    {
      "space": false,
