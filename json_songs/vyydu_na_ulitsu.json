{
  "name": "Выйду на улицу",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Выйду на улицу, солнца нема,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Красные девки свели меня с ума."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Выйду на улицу, гляну на село,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Девчата гуляют и мне весело."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Матушка родная, дай воды холодной,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сердце моё словно кидает в жар."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Раньше гулял я в зелёном саду,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Думал, на улицу век не пойду,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А теперь под вечер аж пятки горят"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ноженьки резвые в пляску хотят."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Я пойду на улицу, к девкам пойду,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Голосом звонким я им подпою."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Матушка, слышишь, соловушек поет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А там, под горою, пляска идет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Девки голосистые звонко поют,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Мне да молодому спать не дают."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Выйду на улицу, солнца нема,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Красные девки свели меня с ума."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Выйду на улицу, гляну на село,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Девчата гуляют и мне весело."
    }
  ]
}
