{
  "name": "Песня Мамонтёнка",
  "category": "Детские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По синему морю к зелёной земле"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Плыву я на белом своём корабле,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "На белом своём корабле,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Меня не пугают ни волны, ни ветер,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Плыву я к единственной маме на свете,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Плыву я сквозь волны и ветер"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "К единственной маме на свете."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Скорей до земли я добраться хочу,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я здесь, я приехал, я ей закричу,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Я маме своей закричу,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть мама услышит, пусть мама придёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть мама меня непременно найдёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ведь так не бывает на свете,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Чтоб были потеряны дети."
    }
  ],
  "performing_artist": null,
  "author_music": null,
  "author_lyrics": null
}
