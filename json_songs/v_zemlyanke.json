{
  "name": "В землянке",
  "category": "Патриотические и Военные Песни",
  "performing_artist": "Народная",
  "author_music": "К. Листов",
  "author_lyrics": "А. Сурков",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Бьется в тесной печурке огонь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На поленьях смола, как слеза."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И поет мне в землянке гармонь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Про улыбку твою и глаза."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Про тебя мне шептали кусты "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В белоснежных полях под Москвой."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я хочу, чтобы слышала ты,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как тоскует мой голос живой."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты сейчас далеко, далеко,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Между нами снега и снега..."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "До тебя мне дойти нелегко,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А до смерти - четыре шага."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пой, гармоника, вьюге назло,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Заплутавшее счастье зови."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мне в холодной землянке тепло"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От моей негасимой любви. "
    }
  ]
}
