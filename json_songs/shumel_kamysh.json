{
  "name": "Шумел камыш",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Шумел камыш, деревья гнулись,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А ночка темная была."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Одна возлюбленная пара"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Всю ночь гуляла до утра."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А поутру они вставали."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кругом помятая трава,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да не одна трава помята, —"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Помята молодость моя."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Придешь домой, а дома спросят:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "«Где ты гуляла, где была?»."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А ты скажи: «В саду гуляла,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Домой тропинки не нашла»."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А если дома ругать будут,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "То приходи опять сюда..."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Она пришла: его там нету,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Его не будет никогда."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Она глаза платком закрыла"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И громко плакать начала:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "«Куда ж краса моя девалась?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кому ж я счастье отдала?..»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Шумел камыш, деревья гнулись,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А ночка темная была."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Одна возлюбленная пара"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Всю ночь гуляла до утра."
    }
  ]
}
