{
  "name": "Братка Беларус",
  "category": "Украинские и Белорусские Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я сустрэу калiсцi чалавека,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "З сiвымi вусамi i у лапцях."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У кашулi, выпаленнай сонцам,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У стогадовых, светлых валасах."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Запрасiу тады яго я сесцi,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А пасля гарэлкай частавау."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "I за чаркай, з говаркай няспешнай,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я у чалавека запытау."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ой, братка-беларус,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Чаму у цябе сiвы вус."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ой, рана пасiвеу,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "бо я долечкi не меу"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ой, братка-беларус,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На руцэ мазоль што гуз.,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так я цяжка працавау"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "рук свах не шкадавау"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Расказау ён пра жыццё былое,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "I пра свой благi i сумны лёс."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "I пра тое як у журбе i горы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На плячах свой цяжкi крыж ён нёс."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За яго жыццё мне сумна стала"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Што яго я лёс не шкадавау."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "I у гаворцы весела няспешна"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я у беларуса запытау."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я сустрэу калiсцi чалавека,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "З сiвымi вусамi i у лапцях."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У кашулi, выпаленнай сонцам,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У стогадовых, светлых валасах."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Запрасiу тады яго я сесцi,"
    },
    {
      "space": false,
      "chorus": false,
