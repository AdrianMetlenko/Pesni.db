{
  "name": "Вечерний звон",
  "category": "Русские Романсы",
  "performing_artist": "Народная",
  "author_music": "А. Алябьев",
  "author_lyrics": "И. Козлов",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вечерний звон,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вечерний звон!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как много дум"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "наводит он"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "О юных днях"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "в краю родном,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где я любил,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "где отчий дом."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И как я, с ним"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "навек простясь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Там слушал звон"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "в последний раз!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Уже не зреть"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "мне светлых дней"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Весны обман-"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "чивой моей!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И сколько нет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "теперь в живых"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тогда веселых,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "молодых!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И крепок их"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "могильный сон;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не слышен им"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вечерний звон."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Лежать и мне"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "в земле сырой!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Напев унывный"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "надо мной"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В долине ветер"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "разнесет;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Другой певец"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "по ней пройдет."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И уж не я,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "а будет он"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В раздумье петь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вечерний звон!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вечерний звон,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вечерний звон!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как много дум"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "наводит он."
    }
  ]
}
