{
  "name": "Прекрасное далеко",
  "category": "Детские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышу голос из прекрасного далёка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Голос утренний в серебряной росе,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышу голос, и манящая дорога"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кружит голову, как в детстве карусель."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Прекрасное далёко, не будь ко мне жестоко,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не будь ко мне жестоко, жестоко не будь."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "От чистого истока в прекрасное далёко,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "В прекрасное далёко я начинаю путь."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышу голос из прекрасного далёка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Он зовёт меня в чудесные края,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышу голос, голос спрашивает строго -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А сегодня что для завтра сделал я."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Прекрасное далёко, не будь ко мне жестоко,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не будь ко мне жестоко, жестоко не будь."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "От чистого истока в прекрасное далёко,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "В прекрасное далёко я начинаю путь."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я клянусь, что стану чище и добрее,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И в беде не брошу друга никогда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышу голос, и спешу на зов скорее"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По дороге, на которой нет следа."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Прекрасное далёко, не будь ко мне жестоко,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не будь ко мне жестоко, жестоко не будь."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "От чистого истока в прекрасное далёко,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "В прекрасное далёко я начинаю путь."
    }
  ]
}
