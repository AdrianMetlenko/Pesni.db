{
  "name": "Во кузнице",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Во ку… во кузнице,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Во ку… во кузнице,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Во кузнице молодые кузнецы."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Они, они куют,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Они, они куют,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Они куют принаваривают,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Молотками приколачивают."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "К себе, к себе Дуню,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "К себе, к себе Дуню,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "К себе Дуню приговаривают."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пойдем, пойдем, Дуня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пойдем, пойдем, Дуня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Пойдем, Дуня, во лесок, во лесок."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сорвем, сорвем Дуне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сорвем, сорвем Дуне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Сорвем Дуне лопушок, лопушок."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под са… под саменький,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под са… под саменький,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Под саменький корешок, корешок."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сошьем, сошьем Дуне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сошьем, сошьем Дуне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Сошьем Дуне сарафан, сарафан."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Носи, носи, Дуня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Носи, носи, Дуня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Носи, Дуня, не марай, не марай."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По пра… по праздничкам,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По пра… по праздничкам,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "По праздничкам надевай, надевай."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В коро… в коробочку,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В коро… в коробочку,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "В коробочку покладай, покладай."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В коро… в коробочке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В коро… в коробочке."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "В коробочке появился таракан."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Проел, проел Дуне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Проел, проел Дуне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Проел Дуне сарафан, сарафан."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Над са… над самою,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Над са… над самою,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Над самою над бедой, над бедой."
    }
  ]
}
