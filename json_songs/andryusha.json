{
  "name": "Андрюша",
  "category": "Патриотические и Военные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эх, путь-дорожка, звени, моя гармошка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Взгляни, как сияют над звёзды рекой."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Парни лихие, девчата огневые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все заговорят наперебой."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Эх, Андрюша, нам ли быть в печали?"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не прячь гармонь, играй на все лады,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так играй, чтобы горы заплясали,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Чтоб зашумели зелёные сады!"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Пой, Андрюша, так, чтоб среди ночи"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ворвался ветер, кудри теребя."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Поиграй, чтобы ласковые очи"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не спросясь глядели на тебя."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эх, путь-дорожка, закрытое окошко,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не выйдет, не встретит девчоночка меня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Горькое слово сказала черноброва,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что в сердце нет ответного огня."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Эх, Андрюша, нам ли быть в печали?"
    },
    {
      "space": false,
