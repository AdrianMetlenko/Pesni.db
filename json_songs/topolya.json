  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тополя, тополя высокие,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "над рекой деревца,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Деревца зеленые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "беспокойной весной"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вы шумите листвой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "и не спится вам вместе со мной,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Тополя, тополя"
