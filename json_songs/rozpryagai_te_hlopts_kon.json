{
  "name": "Розпрягайте, хлопці, коні",
  "category": "Украинские и Белорусские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Розпрягайте, хлопці, коней,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "та й лягайте спочивать."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А я піду в сад зелений,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В сад криниченьку копать."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Маруся раз, два, три!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Калина!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чорнявая дівчина"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "В саду ягоди рвала."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Копав, копав криниченьку"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У зеленому саду."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чи не вийде дівчинонька"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Рано вранці по воду?"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Маруся раз, два, три!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Калина!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чорнявая дівчина"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "В саду ягоди рвала."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вийшла, вийшла дівчинонька"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Рано вранцi воду брать."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А за нею козаченько"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Веде коня напувать."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Маруся раз, два, три!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Калина!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чорнявая дівчина"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "В саду ягоди рвала."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "“Знаю, знаю, дівчинонько,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чим я тебе огорчив:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Що я вчора из вечора"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Краще тебе полюбив."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Маруся раз, два, три!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Калина!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чорнявая дівчина"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "В саду ягоди рвала."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вона ростом нэвэлычка"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ще й годамы молода,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Руса коса до пояса,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В косе лента голуба."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Маруся раз, два, три!"
    },
    {
      "space": false,
