      "x_repeat": false,
      "lyric_line": "та й лягайте спочивать."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А я піду в сад зелений,"
    },
    {
      "space": false,
