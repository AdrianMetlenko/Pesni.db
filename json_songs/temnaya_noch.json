{
  "name": "Темная ночь",
  "category": "Патриотические и Военные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Темная ночь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "только пули свистят по степи"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Только ветер гудит в проводах"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "тускло звезды мерцают"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В темную ночь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ты любимая знаю не спишь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И у детской кроватки тайком"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ты слезу утираешь"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как я люблю"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "глубину твоих ласковых глаз"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как я хочу"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "к ним прижаться теперь губами"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Темная ночь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "разделяет любимая нас"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И тревожная черная степь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "пролегла между нами"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Верю в тебя"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "в дорогую подругу мою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эта вера от пули меня"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "темной ночью хранила"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Радостно мне"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "я спокоен в смертельном бою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Знаю встретишь с любовью меня"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что б со мной ни случилось"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Смерть не страшна"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "с ней встречались не раз мы в степи"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вот и теперь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "надо мною она кружится"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В темную ночь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ты любимая знаю не спишь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И поэтому знаю со мной"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ничего не случится"
    }
  ]
}
