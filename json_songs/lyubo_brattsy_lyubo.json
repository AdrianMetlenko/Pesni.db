{
  "name": "Любо, братцы, любо",
  "category": "Казачьи Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как на быстрый Терек, на высокий берег"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вывели казаки сорок тысяч лошадей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И устлали Терек, и покрылся берег"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сотнями порубанных, пострелянных людей."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Любо, братцы, любо,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "любо, братцы, жить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "С нашим атаманом"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "не приходится тужить!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А первая пуля, а первая пуля,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А первая пуля, братцы, ранила коня."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А вторая пуля, эх, шальная пуля!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А вторая пуля, дура, ранила меня."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Любо, братцы, любо,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "любо, братцы, жить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "С нашим атаманом"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "не приходится тужить!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А жена узнает — немного погорюет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Выйдет за другого, позабудет про меня."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жалко только воли во широком поле,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жалко мать-старушку да буланого коня."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Любо, братцы, любо,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "любо, братцы, жить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "С нашим атаманом"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "не приходится тужить!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кудри мои русые, очи мои светлые"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Травами, бурьяном да полынью зарастут."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кости мои белые, сердце мое смелое"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Коршуны да вороны по степи разнесут."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Любо, братцы, любо,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "любо, братцы, жить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "С нашим атаманом"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "не приходится тужить!"
    }
  ]
}
