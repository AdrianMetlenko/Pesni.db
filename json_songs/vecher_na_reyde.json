{
  "name": "Вечер на рейде",
  "category": "Патриотические и Военные Песни",
  "performing_artist": "Народная",
  "author_music": "В. Соловьев-Седой",
  "author_lyrics": "А. Чуркин",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Споемте, друзья, ведь завтра в поход"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Уйдем в предрассветный туман."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Споем веселей, пусть нам подпоет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Седой боевой капитан."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Прощай, любимый город!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Уходим завтра в море."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И ранней порой"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Мелькнет за кормой"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Знакомый платок голубой."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А вечер опять хороший такой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что песен не петь нам нельзя,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "О дружбе большой, о службе морской"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Подтянем дружнее, друзья!"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Прощай, любимый город!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Уходим завтра в море."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И ранней порой"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Мелькнет за кормой"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Знакомый платок голубой."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На рейде большом легла тишина,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А море окутал туман,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И берег родной целует волна,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И тихо доносит баян:"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Прощай, любимый город!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Уходим завтра в море."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И ранней порой"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Мелькнет за кормой"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Знакомый платок голубой."
    }
  ]
}
