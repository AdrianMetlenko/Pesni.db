{
  "name": "Александра",
  "category": "Разные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не сразу все устроилось,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "москва не сразу строилась,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Москва слезам не верила,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "а верила любви."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Снегами запорошена,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "листвою заворожена,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Найдет тепло прохожему,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "а деревцу - земли."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Александра, александра,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "этот город наш с тобою,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Стали мы его судьбою -"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "ты вглядись в его лицо."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Чтобы ни было вначале,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "утолит он все печали."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Вот и стало обручальным"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "нам садовое кольцо!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Москву рябины красили,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "дубы стояли князями,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но не они, а ясени"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "без спросу наросли."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Москва не зря надеется,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что вся в листву оденется,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Москва найдет для деревца"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "хоть краешек земли."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Александра, александра,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "что там вьется перед нами?"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Это ясень семенами"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "кружит вальс над мостовой."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ясень с видом деревенским"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "приобщился к вальсам венским."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Он пробьется, александра,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "он надышится москвой."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Москва тревог не прятала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "москва видала всякое,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но беды все и горести"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "склонялись перед ней."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Любовь москвы не быстрая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "но верная и чистая, "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "оскольку материнская"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "любовь других сильней."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Александра, александра,"
    },
    {
      "space": false,
