{
  "name": "Солдатушки, бравы ребятушки",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где же ваши деды?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "«Наши деды – славные победы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наши деды!»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где же ваши матки?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "«Наши матки – белые палатки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наши матки!»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где же ваши жены?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "«Наши жены – ружья заряжены,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наши жены!»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А есть у вас и тетки?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "«Есть у нас и тетки – две косушки водки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наши тетки!»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где же ваши сестры?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "«Наши сестры – штыки, сабли остры,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наши сестры!»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где же ваши детки?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "«Наши детки – пули наши метки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наши детки!»"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдатушки, браво-ребятушки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А где же ваша хата?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Наша хата – лагерь супостата,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вот где наша хата!»"
    }
  ]
}
