{
  "name": "С Днём рождения!",
  "performing_artist": "Надежда Кадышева",
  "author_music": "А. Костюк",
  "author_lyrics": "В. Степанов",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От берез упали розовые тени"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И кукушки где-то слышен плач."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть поменьше в жизни будет огорчений,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть побольше будет в ней удач."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так, с днём рожденья,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "друг мой, с днём рожденья!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Поздравляют все тебя друзья."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Будет счастье, радости мгновенья,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Всё сегодня только для тебя!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За окошком вёсны, за окошком зимы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вдаль уносят годы журавли."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть судьбою нашей будем мы хранимы"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На дороге жизни и любви."
    },
