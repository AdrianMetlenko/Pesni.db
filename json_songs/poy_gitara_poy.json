      "lyric_line": "да-ра-да дай-да-да-да,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Да-ра-да дай-да-да-да-да..."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жизнь - кибитка кочевая,"
    },
    {
      "space": false,
      "chorus": false,
