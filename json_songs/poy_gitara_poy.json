{
  "name": "Пой, гитара, пой",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У реки цыгане встали,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "над рекой туман плывёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Повяжу я косы лентой алой."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Только поле знает, поле,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "где цыган коня найдёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "только поле да цыганская гитара."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Э-ой, пой, гитара, пой,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "эй, не трезва, не пьяна,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Эх, табор мой ночной,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "эх, с песнями цыгана. Эх,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "да-ра-да дай-да-да-да,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "да-ра-да дай-да-да-да,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Да-ра-да дай-да-да-да-да..."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эй вы, ночи огневые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "кудри чёрные вразлёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чем, красавец, мы с тобою да не пара?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Только звёзды знают, звёзды,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "где цыган любовь найдёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Только звезды да цыганская гитара."
    },
    {
      "space": true,
