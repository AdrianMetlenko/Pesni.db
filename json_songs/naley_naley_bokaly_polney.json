    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "эту ночь веселей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И пусть наша семья"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "соберётся тесней."
