    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наша юность, друзья,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "пронесётся стрелой,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
