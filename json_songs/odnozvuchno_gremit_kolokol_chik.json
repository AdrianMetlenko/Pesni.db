{
  "name": "Однозвучно гремит колокольчик",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "А. Гурилев",
  "author_lyrics": "И. Макаров",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Однозвучно гремит колокольчик,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И дорога пылится слегка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И уныло по ровному полю"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Разливается песнь ямщика."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Столько грусти в той песне унылой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Столько грусти в напеве родном,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что в душе моей хладной, остылой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Разгорелося сердце огнем."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И припомнил я ночи иные"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И родные поля и леса,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И на очи, давно уж сухие,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Набежала, как искра, слеза."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Однозвучно гремит колокольчик,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И дорога пылится слегка."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И замолк мой ямщик, а дорога"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Предо мной далека, далека…"
    }
  ]
}
