{
  "name": "Серенада Трубадура",
  "category": "Детские Песни",
  "performing_artist": "М. Магомаев",
  "author_music": "Г. Гладков",
  "author_lyrics": "Ю. Энтин",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Луч солнца золотого"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "тьмы скрыла пелена,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И между нами снова"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вдруг выросла стена."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ночь пройдёт, наступит утро ясное,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Знаю, счастье нас с тобой ждёт."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ночь пройдёт, пройдёт пора ненастная,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Солнце взойдёт, солнце взойдёт."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Петь птицы перестали,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Свет звёзд коснулся крыш,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В час грусти и печали"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты голос мой услышь."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ночь пройдёт, наступит утро ясное,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Знаю, счастье нас с тобой ждёт."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ночь пройдёт, пройдёт пора ненастная,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Солнце взойдёт, солнце взойдёт."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солнце взойдёт, солнце взойдёт."
    },
    {
      "space": false,
