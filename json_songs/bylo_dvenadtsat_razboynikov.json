{
  "name": "Было двенадцать разбойников",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Н. Некрасов",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Было двенадцать разбойников,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Был Кудеяр атаман."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Много разбойники пролили"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Крови честных христиан!"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Господу Богу помолимся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "древнюю быль возвестим! "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так в Соловках нам рассказывал"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "инок честной Питирим."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Много добра понаграбили,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жили в дремучем лесу."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сам Кудеяр, из-под Киева"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вывез девицу красу."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Господу Богу помолимся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "древнюю быль возвестим! "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так в Соловках нам рассказывал"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "инок честной Питирим."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Днём с полюбовницей тешился,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ночью набеги творил."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вдруг у разбойника лютого"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Совесть Господь пробудил."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Господу Богу помолимся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "древнюю быль возвестим! "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так в Соловках нам рассказывал"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "инок честной Питирим."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Бросил своих он товарищей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Бросил набеги творить;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сам Кудеяр в монастырь ушёл"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Богу и людям служить!"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Господу Богу помолимся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "древнюю быль возвестим! "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так в Соловках нам рассказывал"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "инок честной Питирим."
    }
  ]
}
