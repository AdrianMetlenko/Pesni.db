{
  "name": "Ой хмариться, туманиться",
  "category": "Украинские и Белорусские Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ой хмариться, туманиться!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Дрібні дощі йдуть!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Там молоді жовнярики"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "мед горілку п’ють."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "П’ють горілку, ще й наливку,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Їдять ягідки!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Та ще й собі споглядають"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "на чужі жінки!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чужа жінка як ягідка!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Як вишневий цвіт!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А ти ж мені, шабелино,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "зав’язала світ!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Візьму ж тебе, шабелино"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Та й за гострий край!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Пущу ж тебе, шабелино,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "в глибокий Дунай!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Плавай, плавай, шабелино!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вчися плавати!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А я піду молоденьку"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "жінку шукати!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А як собі молоденьку"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жіночку знайду!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "То я ж тебе, шабелино,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "на гак зачеплю!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ой хмариться, туманиться!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Дрібні дощі йдуть!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Там молоді жовнярики"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "мед горілку п’ють."
    }
  ]
}
