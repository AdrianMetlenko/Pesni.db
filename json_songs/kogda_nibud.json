{
  "name": "Когда-нибудь",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я могла бы стать твоей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "только сердце как пустыня"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Караваны журавлей"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "пролетают к морю мимо"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пересохшая река"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "не назначенных свиданий"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Разделила берега"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "и осталась между нами."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Когда-нибудь как все"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "я научусь прощать"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Когда-нибудь как все"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "я перестану ждать"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Когда-нибудь как все"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "меня забудешь ты."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На выжженной земле"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "не вырастут цветы."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Белым солнцем обожгло"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "нерастраченную нежность"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Было больше на любовь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "на одну разлуку меньше"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Уместить в одну строку"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "невозможно всё что было"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И на этом берегу"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "я забыла, как любила."
    },
    {
