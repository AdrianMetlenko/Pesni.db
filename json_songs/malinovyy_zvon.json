{
  "name": "Малиновый звон",
  "category": "Русские Романсы",
  "performing_artist": "Н. Гнатюк",
  "author_music": "А. Морозов",
  "author_lyrics": "А. Поперечный",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сквозь полудрёму и сон"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышу малиновый звон,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Это рассвета гонцы, "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В травах звенят бубенцы."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Это средь русских равнин"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вспыхнули гроздья рябин,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Это в родимой глуши"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что-то коснулось души."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Малиновый звон на заре,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Скажи моей милой земле,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Что я в неё с детства влюблён,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Как в этот малиновый звон."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Этот малиновый звон"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От материнских икон,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От той высокой звезды"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да от минувшей беды."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пыльный затеплится шлях,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где мы бродили в полях,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где на заре, как сквозь сон,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слышен малиновый звон."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Малиновый звон на заре,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Скажи моей милой земле,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Что я в неё с детства влюблён,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Как в этот малиновый звон."
    }
  ]
}
