{
  "name": "Если с другом вышел в путь",
  "category": "Детские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Если с другом вышел в путь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Веселей дорога!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Без друзей меня — чуть-чуть,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А с друзьями — много!"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Что мне снег, что мне зной,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Что мне дождик проливной,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Когда мои друзья со мной!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Там, где трудно одному,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Справлюсь вместе с вами!"
