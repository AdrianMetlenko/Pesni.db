{
  "name": "Встань за Веру, Русская земля!",
  "category": "Патриотические и Военные Песни",
  "performing_artist": "Народная",
  "author_music": "В. Агапкин",
  "author_lyrics": "А. Мингалев",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Много песен мы в сердце сложили,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Воспевая родные края,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Беззаветно тебя мы любили,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Святорусская наша земля."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Высоко ты главу поднимала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Словно солнце, твой лик воссиял,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но ты жертвою подлости стала"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тех, кто предал тебя и продал."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И снова в поход труба нас зовет."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мы вновь встанем в строй"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И все пойдем в священный бой."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Встань за Веру, Русская земля!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ждут победы России Святые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отзовись православная рать!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Где Илья твой и где твой Добрыня?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сыновей кличет Родина-мать."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под хоругви встанем мы смело"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Крестным ходом с молитвой пойдем,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За Российское правое дело"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кровь мы русскую честно прольем."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И снова в поход труба нас зовет."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мы вновь встанем в строй"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И все пойдем в священный бой."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Встань за Веру, Русская земля!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все мы - дети Великой Державы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все мы помним заветы отцов,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ради знамени, чести и славы"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не щади ни себя, ни врагов."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Встань, Россия, из рабского плена."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Дух победы зовет, в бой пора!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Подними боевые знамена"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ради Веры, Любви и Добра."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И снова в поход труба нас зовет."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мы вновь встанем в строй"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И все пойдем в священный бой."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Встань за Веру, Русская земля!"
    }
  ]
}
