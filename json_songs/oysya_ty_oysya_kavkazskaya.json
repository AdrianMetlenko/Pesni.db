{
  "name": "Ойся, ты ойся (Кавказская)",
  "category": "Казачьи Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На Кавказе есть гора"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "самая высокая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А под ней течёт река"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "самая глубокая."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ойся, ты ойся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ты меня не бойся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Я тебя не трону,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ты не беспокойся."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На Кавказе девочки"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "самые красивые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На Кавказе мальчики"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "самые счастливые"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На Кавказе есть река,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "через речку мостик,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На мосту стоит коза,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "у козы той хвостик"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ойся, ты ойся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ты меня не бойся,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Я тебя не трону,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ты не беспокойся."
    }
  ]
}
