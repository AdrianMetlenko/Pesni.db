{
  "name": "Одна Калина",
  "category": "Украинские и Белорусские Песни",
  "performing_artist": "София Ротару",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сумно сумно аж за край"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не дивись на мене"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Грай музико грай"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Зимно зимно на душі"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Забирай що хочеш"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тільки залиши..."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Одну калину за вікном"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Одну родину за столом"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Одну стежину щоб додому йшла сама"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Одну любов на все життя"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Одну журбу – до забуття"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "І Україну бо в нас іншої нема"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
