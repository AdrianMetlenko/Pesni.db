{
  "name": "Ах, Самара-Городок",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Платок тонет и не тонет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Потихонечку плывет, - "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Милый любит и не любит,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Только времечко ведет."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ах, Самара-городок,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я, - "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Успокой ты меня!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я росла и расцветала"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "До семнадцати годов,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А с семнадцати годов"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Крушит девушку любовь."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ах, Самара-городок,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я, - "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Успокой ты меня!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Милый спрашивал любови,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я не знала, что сказать, - "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Молода, любви не знала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ну и жалко отказать."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ах, Самара-городок,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я, - "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Успокой ты меня!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Понапрасну небо ясно,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Одна звездочка горит,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Понапрасну милых много, - "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Об одном сердце болит."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ах, Самара-городок,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я, - "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Успокой ты меня!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тебе белая береза,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нету места у реки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Если я тебе невеста, - "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты меня побереги."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ах, Самара-городок,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Беспокойная я,"
    },
    {
      "space": false,
      "chorus": true,
