    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чтобы крови не лилось"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У отчего порога,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чтоб да кривде не жилось –"
