{
  "name": "Взвейтесь соколы орлами",
  "category": "Патриотические и Военные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Взвейтесь, соколы, орлами!"
    },
    {
