{
  "name": "Заплутавшее счастье",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В белом поле вьюга -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "злой зимы подруга."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В белом поле ледяная мгла."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А за полем - лето,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "где в лучах рассвета"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Над ручьями вишня расцвела."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мне бы только зиму пережить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мне бы только поле перейти."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Из лесных ручьёв воды испить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Счастье заплутавшее найти."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Позови, любимый,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "песней соловьиной,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я отвечу иволгой лесной."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как же так случилось,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "то, что лето скрылось"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За холодной снежной пеленой."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мне бы только зиму пережить,"
    },
