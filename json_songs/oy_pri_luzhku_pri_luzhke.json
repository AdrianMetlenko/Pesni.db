{
  "name": "Ой, при лужку, при лужке",
  "performing_artist": "Надежда Кадышева",
  "category": "Казачьи Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ой, при лужку, при лужке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "При широком поле,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "При знакомом табуне"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Конь гулял на воле."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эх, ты гуляй, гуляй, мой конь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пока не споймают,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как споймают - зануздают"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Шелковой уздою."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вот споймал парень коня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Зануздал уздою,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вдарил шпоры под бока,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Конь летел стрелою."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты лети, лети, мой конь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Лети, торопися,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Возле Сашиного двора"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Конь остановился."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Конь остановился,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вдарил копытами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чтобы вышла красна девка"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С черными бровями."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но не вышла красна девка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вышла ее мати."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Здравствуй, здравствуй, милый зять,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пожелайте в хату."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А я в хату не пойду,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пойду во светлицу,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Разбужу я крепким сном"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Спящую девицу."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А девица не спала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Друга поджидала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Правой ручкой обняла,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Крепко целовала."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ой, при лужку, при лужке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "При широком поле,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "При знакомом табуне"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Конь гулял на воле."
    }
  ]
}
