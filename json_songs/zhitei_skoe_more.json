{
  "name": "Житейское море",
  "category": "Православные Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Житейское море"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "играет волнами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В нем радость и горе"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "всегда перед нами."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Никто не ручится,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "никто не узнает,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что может случиться,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что завтра с ним станет."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сегодня ты весел"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "и жизнью доволен,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Раздолья круг тесен,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "а завтра ты - болен."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И, может быть, завтра"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "сырая могила"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Возьмет безвозвратно"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "кипучие силы."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Хоть счастье пригрело,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "но ты не гордися"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нельзя сказать смело:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ешь, пей, веселися ."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Богат ты сегодня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "пируешь роскошно,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но волю Господню"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "узнать невозможно."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И, может быть, завтра,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "больной и с сумою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пойдешь ты скитаться"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "с горючей слезою."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так в море житейском"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "волна за волною"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сменяются резко"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "под нашей ладьею."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наш Кормчий пред нами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "гляди Ему в очи,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И с верой, надеждой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "свершай путь средь ночи."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Житейское море"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "играет волнами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В нем радость и горе"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "всегда перед нами."
    }
  ]
}
