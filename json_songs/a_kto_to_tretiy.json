{
  "name": "А кто-то третий",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Рябины лист колышет ветер,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тропинка вдаль уводит нас,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А кто-то третий,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А кто-то третий"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "С тропинки той не сводит глаз."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Луна за речкой ярко светит,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Волна сливается с волной,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А кто-то третий,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А кто-то третий"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Один остался за рекой."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мы завтра вновь с тобою встретим"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За речкой зореньки восход,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А кто-то третий,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А кто-то третий"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Вновь до рассвета не уснёт."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нет, нелегко на белом свете"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Свою судьбу, любовь найти,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ещё трудней остаться третьим"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "На долгом жизненном пути."
    }
  ]
}
