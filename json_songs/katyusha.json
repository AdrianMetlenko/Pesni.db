{
  "name": "Катюша",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "М. Блантер",
  "author_lyrics": "М. Исаковский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Расцветали яблони и груши,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Поплыли туманы над рекой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Выходила на берег Катюша "
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "На высокий берег на крутой."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Выходила, песню заводила"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Про степного сизого орла."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Про того, которого любила,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Про того, чьи письма берегла."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ой, ты, песня, песенка девичья,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты лети за ясным солнцем вслед"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И бойцу на дальнем пограничье"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "От Катюши передай привет."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть он вспомнит девушку простую"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И услышит как она поёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Пусть он землю бережёт родную,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А любовь Катюша сбережёт."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отцветали яблони и груши,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Уплыли туманы над рекой."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Уходила с берега Катюша,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Уносила песеню за собой."
    }
  ]
}
