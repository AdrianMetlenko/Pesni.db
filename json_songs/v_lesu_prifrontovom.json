{
  "name": "В лесу прифронтовом",
  "category": "Патриотические и Военные Песни",
  "performing_artist": "Народная",
  "author_music": "М. Блантер",
  "author_lyrics": "М. Исаковский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С берез, неслышен, невесом,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слетает желтый лист."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Старинный вальс «Осенний сон»"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Играет гармонист."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вздыхают, жалуясь, басы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И, словно в забытьи,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сидят и слушают бойцы -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Товарищи мои."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под этот вальс весенним днем"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ходили мы на круг;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под этот вальс в краю родном"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Любили мы подруг;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под этот вальс ловили мы"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Очей любимых свет;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под этот вальс грустили мы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Когда подруги нет."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И вот он снова прозвучал"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В лесу прифронтовом,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И каждый слушал и мечтал"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "О чем-то дорогом;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И каждый думал о своей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Припомнив ту весну."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И каждый знал - дорога к ней"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ведет через войну."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть свет и радость прежних встреч"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нам светят в трудный час."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А коль придется в землю лечь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так это ж только раз."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но пусть и смерть в огне, в дыму"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Бойца не устрашит,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И что положено кому -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть каждый совершит."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так что ж, друзья, коль наш черед,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да будет сталь крепка!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть наше сердце не замрет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не задрожит рука."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Настал черед, пришла пора, -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Идем, друзья, идем."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За все, чем жили мы вчера,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За все, что завтра ждем."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С берез, неслышен, невесом,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слетает желтый лист."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Старинный вальс «Осенний сон»"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Играет гармонист."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вздыхают, жалуясь, басы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И, словно в забытьи,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сидят и слушают бойцы -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Товарищи мои."
    }
  ]
}
