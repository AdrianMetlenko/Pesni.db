{
  "name": "Комбат",
  "performing_artist": "Любэ",
  "category": "Патриотические и Военные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А на войне, как на войне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Патроны, водка, махорка в цене."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А на войне нелёгкий труд,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А сам стреляй, а то убьют."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А на войне, как на войне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Подруга, вспомни обо мне."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А на войне, неровен час,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А может, мы, а может, нас."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Комбат-батяня, батяня-комбат,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ты сердце не прятал за спины ребят,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Летят самолеты и танки горят,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Так бьёт, ё, комбат, ё, комбат."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Комбат-батяня, батяня-комбат,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "За нами Россия, Москва и Арбат,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Огонь, батарея, огонь, батальон,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Комбат, ё, командует он."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Огонь, батарея, огонь, батальон."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А на войне, как на войне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солдаты видят мамку во сне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На войне, да то оно,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Там все серьёзней, чем в кино."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да, война, война, война,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Дурная тётка, стерва она,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эх, война, война идёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А пацана девчонка ждёт."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Комбат-батяня, батяня-комбат,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ты сердце не прятал за спины ребят,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Летят самолеты и танки горят,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
