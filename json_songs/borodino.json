{
  "name": "Бородино",
  "category": "Патриотические и Военные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Скажи-ка, дядя, ведь не даром"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Москва, спаленная пожаром,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Французу отдана?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ведь были ж схватки боевые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да, говорят, еще какие!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Недаром помнит вся Россия"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Про день Бородина!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да, были люди в наше время,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не то, что нынешнее племя:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Богатыри - не вы!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Плохая им досталась доля:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Немногие вернулись с поля..."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Не будь на то господня воля,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Не отдали б Москвы!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мы долго молча отступали,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Досадно было, боя ждали,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ворчали старики:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "“Что ж мы? на зимние квартиры?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не смеют, что ли, командиры"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Чужие изорвать мундиры"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "О русские штыки?”"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И вот нашли большое поле:"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Есть разгуляться где на воле!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Построили редут."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У наших ушки на макушке!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чуть утро осветило пушки"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И леса синие верхушки -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Французы тут как тут."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Забил заряд я в пушку туго"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И думал: угощу я друга!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Постой-ка, брат мусью!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что тут хитрить, пожалуй к бою;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Уж мы пойдем ломить стеною,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Уж постоим мы головою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "За родину свою!"
    }
  ]
}
