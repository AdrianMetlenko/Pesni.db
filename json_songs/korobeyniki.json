{
  "name": "Коробейники",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ой, полным-полна моя коробочка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Есть в ней ситец и парча."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Пожалей, душа моя, зазнобушка,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Молодецкого плеча."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Выйду, выйду в рожь высокую,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Там до ночки погожу."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Как завижу свою черноокую."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Все товары разложу."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Цыганочка Аза, Аза."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Цыганочка черноглаза"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Цыганочка чёрная, погадай."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вот и пала ночь туманная,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ждёт удалый молодец."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Чу, идёт, пришла моя желанная,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Продаёт товар купец"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "В роще моей пел соловей."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Не давал покоя тёще моей."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Взял я ружьё, убил соловья."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Спи спокойно, тёща моя."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Катя бережно торгуется,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Всё боится передать."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Парень с девицей целуется,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Просит цену набавлять."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Ёлки - моталки,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "просил я у Наталки."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Просил я у Наталки... "
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "колечко поносить."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "На тебе, на тебе,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "не сказывай матери,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Не рассказывай отцу."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Знает только ночь глубокая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как поладили они."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Распрямись ты, рожь высокая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Тайну свято сохрани."
    }
  ]
}
