{
  "name": "Вот кто-то с горочки спустился",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вот кто-то с горочки спустился"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наверно милый мой идет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "На нем защитна гимнастерка"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Она с ума меня сведет"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На нем погоны золотые"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И яркий орден на груди"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Зачем зачем я повстречала"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Его на жизненном пути"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Зачем когда проходит мимо"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С улыбкой машет мне рукой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Зачем он в наш колхоз приехал"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Зачем нарушил мой покой"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Его увижу сердце сразу"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В моей волнуется груди"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Зачем зачем я повстречала"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Его на жизненном пути"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вот кто-то с горочки спустился"
    },
    {
      "space": false,
