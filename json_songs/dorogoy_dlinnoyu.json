{
  "name": "Дорогой длинною",
  "category": "Русские Романсы",
  "performing_artist": "Народная",
  "author_music": "Б. Фомин",
  "author_lyrics": "К. Подревский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ехали на тройке с бубенцами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А вдали мелькали огоньки."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эх, когда бы мне теперь за вами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Душу бы развеять от тоски…"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Дорогой длинною,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "да ночью лунною,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Да с песней той,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "что вдаль летит, звеня."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И с той старинною,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "да с семиструнною,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Что по ночам"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "так мучила меня."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да, выходит пели мы задаром,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Понапрасну ночь за ночью жгли."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Если мы покончили со старым,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так и ночи эти отошли."
    },
    {
      "space": true,
