{
  "name": "Мне не жаль ничего",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жизнь моя,ты летишь, словно конь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я тебя удержать не могу,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты летишь,выбивая огонь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На камнях, на траве, на снегу."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ты неси меня, конь, в неоглядную даль,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мне весны отгоревшей не жаль."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Мне не жаль никого, мне не жаль ничего,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Оттого и на сердце легко."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я уже не вернусь в белый сад,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под черёмуху первой любви."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Обманул меня ласковый взгляд,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Обманули меня соловьи."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ты неси меня, конь, в неоглядную даль,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мне весны отгоревшей не жаль."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Мне не жаль никого, мне не жаль ничего,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Оттого и на сердце легко."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "То леса, то луга, то поля,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я забыла, где дом мой родной."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вьётся по ветру грива коня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Никого не осталось со мной."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ты неси меня, конь, в неоглядную даль,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Мне весны отгоревшей не жаль."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Мне не жаль никого, мне не жаль ничего,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Оттого и на сердце легко."
    }
  ]
}
