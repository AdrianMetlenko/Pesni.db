{
  "name": "Молитва",
  "category": "Православные Песни",
  "performing_artist": "Народная",
  "author_music": "М. Глинка",
  "author_lyrics": "М. Лермонтов",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В минуту жизни трудную,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Теснится ль в сердце грусть,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Одну молитву чудную"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Твержу я наизусть."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Есть сила благодатная"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В созвучье слов живых,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И дышит непонятная,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Святая прелесть в них."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С души как бремя скатится,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сомненье далеко —"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И верится, и плачется,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И так легко, легко..."
    }
  ]
}
