{
  "name": "Улыбка",
  "category": "Детские Песни",
  "performing_artist": "В. Румянова",
  "author_music": "В. Шаинский",
  "author_lyrics": "М. Пляцковский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От улыбки хмурый день светлей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От улыбки в небе радуга проснётся,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Поделись улыбкою своей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И она к тебе не раз ещё вернётся."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И тогда наверняка вдруг запляшут облака"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И кузнечик запиликает на скрипке,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "С голубого ручейка начинается река,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ну а дружба начинается с улыбки."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "С голубого ручейка начинается река,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ну а дружба начинается с улыбки."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От улыбки солнечной одной"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Перестанет плакать самый грустный дождик,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Добрый лес простится с тишиной"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И захлопает в зелёные ладоши."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От улыбки станет всем теплей"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И слону, и даже маленькой улитке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так пускай повсюду на земле"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Словно лампочки включаются улыбки."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И тогда наверняка вдруг запляшут облака"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И кузнечик запиликает на скрипке,"
    },
    {
      "space": true,
