      "x_repeat": true,
      "lyric_line": "Ну а дружба начинается с улыбки."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "С голубого ручейка начинается река,"
    },
    {
      "space": false,
