{
  "name": "Спят усталые игрушки",
  "category": "Детские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Спят усталые игрушки, книжки спят,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Одеяла и подушки ждут ребят."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Даже сказка спать ложится,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Чтобы ночью нам присниться,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ты ей пожелай баю-бай."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Обязательно по дому в этот час"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тихо-тихо ходит дрёма возле нас."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "За окошком всё темнее,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Утро ночи мудренее,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Глазки закрывай, баю-бай."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Баю-бай, должны все люди ночью спать,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Баю-баю, завтра будет день опять."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "За день мы устали очень,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Скажем всем - спокойной ночи,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Глазки закрывай, баю-бай."
    }
  ]
}
