{
  "name": "Давай, дружок, на посошок",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Люблю я праздники, люблю веселые,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Когда фонарики горят,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Когда глаза твои, глаза влюбленные"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "О самом главном говорят."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Давай, дружок, на посошок"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "За нас за всех, за всех за нас,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Пусть будет всем нам хорошо"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И в добрый час, и в добрый час."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть годы катятся, мы не торгуемся,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "К чему ненужные слова?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Давай обнимемся да поцелуемся,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да так, чтоб кругом голова."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Давай, дружок, на посошок"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "За нас за всех, за всех за нас,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Пусть будет всем нам хорошо"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И в добрый час, и в добрый час."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Звезда счастливая на землю падает."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Играй, гармошка, веселей!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нас жизнь еще не раз с тобой порадует,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И мы порадуемся ей."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Давай, дружок, на посошок"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "За нас за всех, за всех за нас,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Пусть будет всем нам хорошо"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И в добрый час, и в добрый час."
    }
  ]
}
