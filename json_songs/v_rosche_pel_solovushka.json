{
  "name": "В роще пел соловушка",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В роще пел соловушка, там вдали"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Песенку о счастье и о любви"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Песенка знакомая и мотив простой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ой ой как ты мне нравишься, ой ой ё ёй"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Губы твои алые, брови дугой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Век бы целовала бы мой дорогой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Только на свидания не ходи с другой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ой ой как ты мне нравишься, ой ой ё ёй"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я умею чуточку колдовать"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сети мои крепкие тебе не разорвать"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "С чарами не справишься, век ты будешь мой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ой ой как ты мне нравишься, ой ой ё ёй"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все девчонки бегают за тобой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что же тут поделаешь, если ты такой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Я бы тебя спрятала в роще за рекой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ой ой как ты мне нравишься, ой ой ё ёй"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "В роще пел соловушка, там вдали да да да"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Песенку о счастьи и о любви"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "С чарами не справишься, век ты будешь мой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ой ой как ты мне нравишься, ой ой е ё ёй"
    }
  ]
}
