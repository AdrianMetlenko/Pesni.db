{
  "name": "На теплоходе музыка играет",
  "category": "Разные Песни",
  "performing_artist": "Ольга Зарубина",
  "author_music": "В. Добрынин",
  "author_lyrics": "М. Рябинин",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Теплоходный гудок"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "разбудил городок,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На причале толпится народ."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все волнуются ждут,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Только десять минут"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Здесь всего лишь стоит теплоход"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На теплоходе музыка играет,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А я одна стою на берегу,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Машу рукой, а сердце замирает"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И ничего поделать не могу."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты приехал сюда"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "и казалось тогда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что ты мне предназначен судьбой."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А потом целый год"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "я ждала теплоход,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чтобы вновь повстречаться с тобой,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На теплоходе музыка играет,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А я одна стою на берегу,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Машу рукой, а сердце замирает"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И ничего поделать не могу."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вот опять теплоход"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "убавляет свой ход,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я того, что не сбудется, жду."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Первый снег в городке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Первый лёд на реке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я к тебе по нему не дойду,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На теплоходе музыка играет,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А я одна стою на берегу,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Машу рукой, а сердце замирает"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И ничего поделать не могу."
    }
  ]
}
