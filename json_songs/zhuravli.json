{
  "name": "Журавли",
  "category": "Патриотические и Военные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мне кажется порою, что солдаты"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С кровавых не пришедшие полей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не в землю нашу полегли когда-то,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А превратились в белых журавлей."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Они до сей поры с времен тех дальних"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Летят и подают нам голоса."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не потому ль так часто и печально"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мы замолкаем глядя в небеса?"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Летит, летит по небу клин усталый,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Летит в тумане на исходе дня."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И в том строю есть промежуток малый"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Быть может это место для меня."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Настанет день и журавлиной стаей"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я поплыву в такой же сизой мгле."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Из-под небес по-птичьи окликая"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Всех вас, кого оставил на земле."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мне кажется порою, что солдаты"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С кровавых не пришедшие полей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не в землю нашу полегли когда-то,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А превратились в белых журавлей."
    }
  ]
}
