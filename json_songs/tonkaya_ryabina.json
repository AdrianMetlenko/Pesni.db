{
  "name": "Тонкая рябина",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что стоишь качаясь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "тонкая рябина,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Головой склоняясь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "до самого тына,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А через дорогу,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "за рекой широкой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Также одиноко"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "дуб стоит высокий."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как бы мне, рябине,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "к дубу перебраться,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я тогда б не стала"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "гнуться и качаться,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тонкими ветвями"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "я б к нему прижалась"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И с его листвою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "день и ночь шепталась."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но нельзя рябине"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "к дубу перебраться,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Знать, ей сиротине"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "век одной качаться,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что стоишь качаясь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "тонкая рябина,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Головой склоняясь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "до самого тына,"
    }
  ]
}
