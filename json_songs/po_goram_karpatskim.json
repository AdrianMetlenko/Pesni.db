  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По горам Карпатским"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "метелица вьётся,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Лютые морозы"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "чудовище творят."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А казаки чёрны,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "чёрны, чернобровы"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С германцами бьются"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "за Родину стоят."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Хотели германцы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "чтоб наши казаки"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "К ихнему престолу"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "служить пошли."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А наши казаки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "храбрые вояки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "К ихнему престолу"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "служить не пошли."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Заиграли трубы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "били барабаны."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отворились двери"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "и вышел генерал."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Полилась рекою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Полилась рекою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Полилась рекою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "горячая кровь."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По горам Карпатским"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "метелица вьётся,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Лютые морозы"
    },
    {
      "space": false,
