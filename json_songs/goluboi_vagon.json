      "lyric_line": "голубой вагон."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Голубой вагон бежит качается,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Скорый поезд набирает ход."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ну зачем же этот день кончается?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пусть бы он тянулся целый год!"
    },
