{
  "name": "Голубой вагон",
  "category": "Детские Песни",
  "performing_artist": "В. Ферапонтов",
  "author_music": "В. Шаинский",
  "author_lyrics": "Э. Успенский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Медленно минуты уплывают вдаль"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Встречи с ними ты уже не жди."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И хотя нам прошлого немного жаль"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Лучшее конечно впереди."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Скатертью скатертью"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "дальний путь"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "стелится"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И упирается"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "прямо в небосклон."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Каждому каждому"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "в лучшее"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "верится,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Катится катится"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "голубой вагон."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Может мы обидели кого-то зря"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Календарь закроет этот лист."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "К новым приключениям спешим друзья"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Эй, прибавь-ка ходу машинист."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Скатертью скатертью"
    },
    {
      "space": false,
