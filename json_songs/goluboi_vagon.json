      "lyric_line": "в лучшее"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "верится,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Катится катится"
    },
    {
      "space": false,
      "chorus": true,
