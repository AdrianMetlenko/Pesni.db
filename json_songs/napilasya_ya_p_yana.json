{
  "name": "Напилася я пьяна",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Напилася я пьяна,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "не дойду я до дому,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Довела меня"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "тропка дальняя"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "до вишнёвого сада"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Там кукушка кукует,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "моё сердце волнует,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ты скажи-ка мне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "расскажи-ка мне,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Где мой милый ночует"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Если он при дороге,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "помоги ему Боже,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Если с любушкой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "на постелюшке,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "накажи его, Боже"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чем же я не такая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "чем чужая, другая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Я хорошая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "я пригожая,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "только доля такая,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Если б раньше я знала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что так замужем плохо,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Расплела бы я"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "русу косоньку,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "да сидела б я дома,"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Напилася я пьяна,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "не дойду я до дому,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Довела меня"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "тропка дальняя"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "до вишнёвого сада"
    }
  ]
}
