{
  "name": "Уходи горе",
  "performing_artist": "Надежда Кадышева",
  "author_music": "А. Костюк",
  "author_lyrics": "В. Степанов",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Первые слёзы - не беда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "первые слёзы, как вода,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "В травы густые упадут,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "нежной ромашкой расцветут."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Уходи, горе, за сине море,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "за тёмный лес, за ясный огонь."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Уходи лесом, уходи полем,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "уходи, горе, меня не тронь."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Слёзы вторые - яблонь грусть,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "милый не любит, ну и пусть!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Красное лето впереди,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "встречу другого на пути."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Уходи, горе, за сине море,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "за тёмный лес, за ясный огонь."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Уходи лесом, уходи полем,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "уходи, горе, меня не тронь."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Третьи же слёзы - то беда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "пусть их не будет никогда."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Что же на зорьке вдруг опять"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "плачет кукушка - не унять?"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Уходи, горе, за сине море,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "за тёмный лес, за ясный огонь."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Уходи лесом, уходи полем,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "уходи, горе, меня не тронь."
    }
  ]
}
