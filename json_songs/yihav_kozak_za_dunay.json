{
  "name": "Йихав козак за Дунай",
  "category": "Украинские и Белорусские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Їхав козак за Дунай,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "сказав: «Дівчино, прощай!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ти, конику вороненький,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "неси та гуляй!»"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б не ходить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б не любить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б та й не знать,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чим тепер, чим тепер забувать."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Постій, постій, мій козаче,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "твоя дівчина плаче,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "На кого ж ти покидаєш"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "тільки подумай."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б не ходить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б не любить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б та й не знать,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чим тепер, чим тепер забувать."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "«Білих ручок не ламай,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ясних очок не стирай;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мене з війни із славою"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "к собі дожидай»."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б не ходить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б не любить,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Лучше було б, лучше було б та й не знать,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Чим тепер, чим тепер забувать."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "«Не хочу я нічого,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "тільки тебе одного;"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Будь здоров, мій миленький,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "а все пропадай»."
