{
  "name": "Червона рута",
  "category": "Украинские и Белорусские Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ти признайся менi,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Звiдки в тебе тi чари,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я без тебе всi дні"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У полонi печалi."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Може, десь у лiсах"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ти чар-зiлля шукала,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сонце руту знайшла"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "І мене зчарувала?"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Червону - руту"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не шукай вечорами,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ти у мене єдина,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Тiльки ти, повiр."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Бо твоя врода"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "То є чистая вода,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "То є бистрая вода"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Синiх гiр."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Бачу я тебе в снах,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У дiбровах зелених,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "По забутих стежках"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ти приходиш до мене."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "I не треба нести"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Менi квiтку надiї,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Бо давно уже ти"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Увiйшла в мої мрiї."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Червону - руту"
    },
    {
