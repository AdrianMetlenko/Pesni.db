{
  "name": "Березы",
  "performing_artist": "Любэ",
  "author_music": "И. Матвиенко",
  "author_lyrics": "М. Андреев",
  "category": "Русские Романсы",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отчего так в России берёзы шумят,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отчего белоствольные всё понимают."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У дорог прислонившись, по ветру стоят"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И листву так печально кидают."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Я пойду по дороге, простору я рад,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Может, это лишь всё, что я в жизни узнаю."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отчего так печальные листья летят,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под рубахою душу лаская."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А на сердце опять горячо-горячо"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "И опять, и опять без ответа."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А листочек с берёзки упал на плечо,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Он, как я, оторвался от веток."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Посидим на дорожку, родная, с тобой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты пойми, я вернусь, не печалься, не стоит."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И старуха махнёт на прощанье рукой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И за мною калитку закроет."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отчего так в России берёзы шумят,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отчего хорошо так гармошка играет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пальцы ветром по кнопочкам в раз пролетят,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А последняя, эх, западает."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "А на сердце опять горячо-горячо"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "И опять, и опять без ответа."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "А листочек с берёзки упал на плечо,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": true,
      "lyric_line": "Он, как я, оторвался от веток."
    }
  ]
}
