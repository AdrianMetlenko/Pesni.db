      "lyric_line": "превратит в цветы"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Встреча была коротка"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "в ночь ее поезд увез"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но в ее жизни была"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "песня безумная роз"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Прожил художник один"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "много он бед перенес"
    },
    {
      "space": false,
      "chorus": false,
