{
  "name": "Миллион алых роз",
  "performing_artist": "Алла Пугачева",
  "author_music": "Р. Паулс",
  "author_lyrics": "А. Вознесенский",
  "category": "Русские Романсы",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жил-был художник один"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "домик имел и холсты"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но он актрису любил"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "ту что любила цветы"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Он тогда продал свой дом"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "продал картины и кров"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И на все деньги купил"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "целое море цветов"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Миллион миллион"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "миллион алых роз"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Из окна из окна"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "из окна видишь ты"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Кто влюблен кто влюблен"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "кто влюблен и всерьез"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Свою жизнь для тебя"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "превратит в цветы"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Утром ты встанешь у окна"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "может сошла ты с ума"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как продолжение сна"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "площадь цветами полна"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Похолодеет душа"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что за богач здесь чудит"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А под окном чуть дыша"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "бедный художник стоит"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Миллион миллион"
    },
    {
      "space": false,
