{
  "name": "То не ветер ветку клонит",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "То не ветер ветку клонит"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не дубравушка шумит"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "То мое, мое сердечко стонет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Как осенний лист дрожит"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Извела меня кручина"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Подколодная змея"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Догорай, гори, моя лучина"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Догорю с тобой и я"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не житье мне здесь без милой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С кем теперь идти к венцу"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Знать, судил, судил мне рок с могилой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Обручиться молодцу"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "То не ветер ветку клонит"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не дубравушка шумит"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "То мое, мое сердечко стонет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Как осенний лист дрожит"
    }
  ]
}
