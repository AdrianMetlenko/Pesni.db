{
  "name": "Будь счастлив",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Счастлив тот, чья родина - Восток"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "в седой дали,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Там встаёт рассвета цветок"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "для всей земли."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Раньше всех увидишь день"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "и не страшна беда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так было всегда."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Счастлив кто на Севере живёт,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "снег да луна,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Всё-равно растает лёд,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "придёт весна."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Там надежда в стылой мгле"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "яркая, как звезда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так было всегда."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Счастлив тот, чей дом - горячий Юг"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "страна мечты,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Вдалеке от шумных вьюг"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "поют цветы."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Можно их друзьям дарить"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "просто и без труда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так было всегда."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Счастлив и на Западе друг,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "легко понять,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солнце здесь закончив круг"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "уходит спать."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Принося с собой покой,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "прячется без следа,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Так было всегда."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Счастлив тот, чья родина - Земля,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "давай кружись,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И моря, и поля"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "всем дарят жизнь."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Есть и радость, и печаль,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "пусть шелестят года,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Так будет всегда."
    }
  ]
}
