{
  "name": "Барыня",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "Народная",
  "author_lyrics": "Народная",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "У нас нонче субботея,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А на завтра воскресенье."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Барыня ты моя, сударыня ты моя."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А-а, воскресенье."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ко мне нонче друг Ванюша приходил,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Три кармана друг Ванюша приносил."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Барыня ты моя, сударыня ты моя,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А-а, друг Ванюша приносил."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Первый карман со деньгами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Второй карман с орехами."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Барыня ты моя, сударыня ты моя,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А-а, с орехами."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Третий карман со изюмом,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Третий карман со изюмом."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Барыня ты моя, сударыня ты моя."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А-а, со изюмом."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Со деньгами любить можно,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От орехов зубы больно."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Барыня ты моя, сударыня ты моя."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А-а, зубы больно."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "От изюма губы сладки,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нельзя с милым целоваться."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Барыня ты моя, сударыня ты моя."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А-а, целоваться."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нельзя с милым целоваться,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Можно только обниматься."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Барыня ты моя, сударыня ты моя."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "А-а, обниматься."
    }
  ]
}
