  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты всё ещё веришь в любовь,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Фильмами добрыми бредишь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
