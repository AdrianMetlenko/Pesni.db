      "lyric_line": "Веришь."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Младшая моя сестрёнка,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Что же ничего не скажешь мне."
