{
  "name": "Песенка друзей",
  "category": "Детские Песни",
  "performing_artist": "О. Анофриев",
  "author_music": "Г. Гладков",
  "author_lyrics": "Ю. Энтин",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ничего на свете лучше нету,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Чем бродить друзьям по белу свету."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Тем, кто дружен, не страшны тревоги,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нам любые дороги дороги,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-ла-ла-ла ла-ла-ла-ла-ла"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-е е-е е-е"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Мы своё призванье не забудем -"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Смех и радость мы приносим людям."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Нам дворцов заманчивые своды"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Не заменят никогда свободы,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-ла-ла-лала-ла-ла-ла-ла"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-е е-е е-е"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наш ковёр - цветочная поляна,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наши стены - сосны-великаны."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наша крыша - небо голубое,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Наше счастье - жить такой судьбою,"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-ла-ла-лала-ла-ла-ла-ла"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла ла-ла-ла-ла-ла"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-ла-ла-лала-ла-ла-ла-ла"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Ла-ла-ла-е е-е е-е"
    }
  ]
}
