{
  "name": "Синий платочек",
  "category": "Патриотические и Военные Песни",
  "performing_artist": "К. Шульженко",
  "author_music": "Е. Петерсбурский",
  "author_lyrics": "М. Максимов",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Синенький, скромный платочек"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Падал с опущенных плеч."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты говорила, что не забудешь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ласковых радостных встреч."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Порой ночной"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "мы повстречались с тобой."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Белые ночи, Синий платочек"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Милый, желанный, родной"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Кончилась зимняя стужа,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Даль голубая ясна."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Сердце согрето, вериться в лето"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Солнцем ласкает весна!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И вновь, Весной"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Под тенистой зеленой сосной,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Мелькнет среди ночи синий платочек"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Милый, желанный, родной"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Помнишь при нашей разлуке"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ты принесла мне к реке"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "С лаской пращальной горсть незабудок"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "В шелковом синем платке."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И мне не раз"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "снились в предутренний час,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Кудри в платочке, Синие искры"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ласковых девечьих глаз!"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За них! Родных!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Желаных, Любимых таких!"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Страчит пулеметчик за синий платочек,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Что был на плечах дорогих!"
    }
  ]
}
