{
  "name": "Челита",
  "category": "Разные Песни",
  "performing_artist": "К. Шульженко",
  "author_music": "М. Фернандес",
  "author_lyrics": "Н. Лабковский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ну кто в нашем крае Челиту не знает?"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Она так умна и прекрасна."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И вспыльчива так и властна,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что ей возражать опасно."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И утром и ночью поет и хохочет,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Веселье горит в ней, как пламя,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И шутит она над нами,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И с нею мы шутим сами."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А-я-я-яй! Что за девчонка!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На все тотчас же сыщет ответ,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Всегда смеется звонко."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А-я-я-яй! Зря не ищи ты,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "В деревне нашей, право же, нет"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Другой такой Челиты."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Жемчужные горы сулят ей сеньоры,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но денег Челите не надо,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Она весела и рада"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Без денег и без наряда."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Пo нраву Челите лишь солнце в зените,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И всех кавалеров шикарней"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Считает простого парня,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что служит у нас в пекарне."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А-я-я-яй! Что за девчонка!"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "На все тотчас же сыщет ответ,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Всегда смеется звонко."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А-я-я-яй! Зря не ищи ты,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "В деревне нашей, право же, нет"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Другой такой Челиты."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Для нашей Челиты все двери открыты,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Хоть лет ей неполных семнадцать,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Но взрослые все, признаться,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Ее, как огня, боятся."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И любим ее мы и вердим ее мы,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И справиться с нею нет мочи."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Над нами она хохочет"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "И делает все, что хочет."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А-я-я-яй! Что за девчонка!"
    },
    {
