{
  "name": "Я не колдунья",
  "performing_artist": "Надежда Кадышева",
  "category": "Народные Песни",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "За мои зеленые глаза"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "называешь ты меня колдуньей,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Говоришь ты это мне не зря"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "сердце у тебя я забрала."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Все меня ругают, что женат,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что уже детишек у вас двое,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Что же делать мне с тобой тогда,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "что же делать мне с тобою."
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А я вовсе не колдунья,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "я любила и люблю,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Это мне судьба послала"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "грешную любовь мою."
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Не судите строго люди"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "пожалей меня родня,"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "Видно в жизни суждено"
    },
    {
      "space": false,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "мне выпить грешного вина."
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Видно зря колдуньей называл,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "не смогла тебя приворожить я,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "А мои зеленые глаза"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "навсегда заволокла слеза."
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Отпущу тебя я и уйду,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "вновь вернешься ты к жене и детям,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Как же без тебя я проживу,"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "если лучший ты на свете?"
    },
    {
      "space": true,
      "chorus": true,
      "x_repeat": false,
      "lyric_line": "А я вовсе не колдунья,"
    },
