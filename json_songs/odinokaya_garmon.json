{
  "name": "Одинокая гармонь",
  "category": "Народные Песни",
  "performing_artist": "Народная",
  "author_music": "Б. Мокроусов",
  "author_lyrics": "М. Исаковский",
  "lyrics": [
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Снова замерло все до рассвета"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Дверь не скрипнет не вспыхнет огонь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Только слышно на улице где-то"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Одинокая бродит гармонь"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "То пойдет на поля за ворота"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "То вернется обратно опять"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Словно ищет в потемках кого-то"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "И не может никак отыскать"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Веет с поля ночная прохлада"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "С яблонь цвет облетает густой"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ты признайся кого тебе надо"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Ты скажи гармонист молодой"
    },
    {
      "space": true,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Может радость твоя недалеко"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": false,
      "lyric_line": "Да не знает ее ли ты ждешь"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Что ж ты бродишь всю ночь одиноко"
    },
    {
      "space": false,
      "chorus": false,
      "x_repeat": true,
      "lyric_line": "Что ж ты девушкам спать не даешь"
    }
  ]
}
